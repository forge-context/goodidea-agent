# Required when running the live Tavily search adapter.
TAVILY_API_KEY=

# Model configuration. The names are provider-neutral on purpose: switching
# provider is a change to these values, not to any Python file. Any endpoint that
# speaks the OpenAI Chat Completions format works here.
#
#   Bailian (Alibaba)  base URL is the OpenAI-compatible endpoint from the console;
#                      GOODIDEA_MODEL_EXTRA_BODY must disable thinking for a
#                      non-streaming call: {"enable_thinking": false}
#   OpenAI             https://api.openai.com/v1  (no extra body needed)
#   DeepSeek           https://api.deepseek.com/v1
#   Local (vLLM etc.)  http://127.0.0.1:8000/v1
GOODIDEA_MODEL_BASE_URL=
GOODIDEA_MODEL_API_KEY=
GOODIDEA_MODEL_NAME=

# Optional. JSON object merged into the request body for provider-specific fields.
# Quote the value: `set -a && source .env` runs through the shell, and bare braces
# or spaces break it. Bailian/qwen3 needs '{"enable_thinking": false}' for a
# non-streaming call.
GOODIDEA_MODEL_EXTRA_BODY=

# Optional. Request timeout in seconds; defaults to 30.
GOODIDEA_MODEL_TIMEOUT_SECONDS=

# Local API database path.
GOODIDEA_DATABASE=goodidea.db
